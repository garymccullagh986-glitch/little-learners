rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ONLY the two parents can read or write the learning journal.
    // Replace the two emails below with your Google sign-in emails (lower case).
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'YOUR_EMAIL@gmail.com',
          'PARTNER_EMAIL@gmail.com'
        ];
    }

    match /ll_entries/{id}  { allow read, write: if isFamily(); }
    match /ll_checks/{id}   { allow read, write: if isFamily(); }
    match /ll_settings/{id} { allow read, write: if isFamily(); }
    match /ll_weeks/{id}    { allow read, write: if isFamily(); }
  }
}
